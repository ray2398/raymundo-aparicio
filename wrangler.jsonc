
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raymundo-aparicio",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
